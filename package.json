{
  "name": "portfolio-bot-server",
  "version": "1.0.0",
  "description": "Express backend for Dvir Levy Portfolio AI Avatar",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "cross-env NODE_ENV=production node server.js",
    "dev": "cross-env NODE_ENV=development nodemon server.js",
    "build": "echo 'No build step required. Server runs directly.'",
    "db": "docker-compose -f docker/docker-compose-rag-db.yml up -d",
    "close-db": "docker-compose -f docker/docker-compose-rag-db.yml down",
    "connect-db": "docker exec -it rag-postgres psql -U postgres -d rag_db"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.1",
    "morgan": "^1.10.1",
    "openai": "^4.80.1",
    "pg": "^8.20.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.14"
  },
  "nodemonConfig": {
    "ignore": [
      "logs/*"
    ]
  }
}